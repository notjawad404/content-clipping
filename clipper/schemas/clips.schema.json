{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["video_id", "clips"],
  "properties": {
    "video_id": {"type": "string"},
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start_sentence", "end_sentence", "hook_text", "title", "score", "scores",
                     "reason", "emphasis_words", "post"],
        "properties": {
          "id": {"type": "string", "pattern": "^clip_[0-9]{2}$"},
          "start_sentence": {"type": "string", "pattern": "^S[0-9]{4}$"},
          "end_sentence": {"type": "string", "pattern": "^S[0-9]{4}$"},
          "hook_text": {"type": "string", "minLength": 3, "maxLength": 60},
          "title": {"type": "string", "minLength": 3},
          "score": {"type": "number", "minimum": 0, "maximum": 10},
          "scores": {
            "type": "object",
            "required": ["hook", "standalone", "payoff", "emotion", "novelty", "shareability"],
            "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}
          },
          "reason": {"type": "string"},
          "emphasis_words": {"type": "array", "items": {"type": "string"}},
          "post": {
            "type": "object",
            "required": ["instagram", "tiktok", "youtube", "x"],
            "additionalProperties": {"type": "string"}
          }
        }
      }
    }
  }
}
